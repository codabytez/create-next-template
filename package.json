{
  "name": "@codabytez/create-next-template",
  "version": "0.1.13",
  "description": "CLI to scaffold Next.js projects with your preferred stack",
  "bin": {
    "create-next-template": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --clean",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm audit --audit-level=moderate"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.6.2",
    "execa": "^8.0.1",
    "fs-extra": "^11.3.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.37",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
